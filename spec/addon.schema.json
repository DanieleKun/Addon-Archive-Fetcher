{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DanieleKun/Addon-Archive-Fetcher/blob/main/spec/addon.schema.json",
  "title": "Archive Fetcher addon manifest, spec 1",
  "description": "Informative schema for editor completion. tools/addonlib/validate.py is the reference validator.",
  "type": "object",
  "required": ["spec", "id", "name", "version", "categories"],
  "properties": {
    "spec": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "description": { "type": "string", "maxLength": 400 },
    "homepage": { "type": "string", "pattern": "^https://", "maxLength": 300 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$" },
    "category": {
      "type": "object",
      "required": ["id", "name", "consoles"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "consoles": { "type": "array", "items": { "$ref": "#/$defs/console" } }
      }
    },
    "console": {
      "type": "object",
      "required": ["id", "name", "collections"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "collections": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/collection" } }
      }
    },
    "collection": {
      "type": "object",
      "required": ["title", "source"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "format": { "type": "string", "pattern": "^[a-z0-9]{1,8}$" },
        "source": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string" },
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
            "path": { "type": "string", "maxLength": 300 },
            "expand": { "const": "zip" }
          },
          "if": { "properties": { "type": { "const": "archive.org-item" } } },
          "then": { "required": ["id"] }
        }
      }
    }
  }
}
