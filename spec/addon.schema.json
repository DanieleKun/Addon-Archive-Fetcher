{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DanieleKun/Addon-Archive-Fetcher/blob/main/spec/addon.schema.json",
  "title": "Cartshelf addon manifest, spec 1",
  "description": "Informative schema for editor completion. tools/addonlib/validate.py is the reference validator.",
  "type": "object",
  "required": [
    "spec",
    "id",
    "name",
    "version",
    "categories"
  ],
  "properties": {
    "spec": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "maxLength": 400
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 300
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,59}$"
    },
    "category": {
      "type": "object",
      "required": [
        "id",
        "name",
        "consoles"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "consoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/console"
          }
        }
      }
    },
    "console": {
      "type": "object",
      "required": [
        "id",
        "name",
        "collections"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "collections": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "#/$defs/collection"
          }
        },
        "thumbnails": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]{0,79}$"
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "title",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "format": {
          "type": "string",
          "pattern": "^[a-z0-9]{1,8}$"
        },
        "source": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "archive.org-item, http-directory, file-list or files. Unknown types are skipped by apps."
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
            },
            "path": {
              "type": "string",
              "maxLength": 300
            },
            "expand": {
              "const": "zip"
            },
            "url": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2000,
              "description": "http-directory: the folder page. file-list: the JSON feed."
            },
            "extensions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]{1,8}$"
              }
            },
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2000,
              "items": {
                "$ref": "#/$defs/file"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "archive.org-item"
                  }
                }
              },
              "then": {
                "required": [
                  "id"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "http-directory"
                  }
                }
              },
              "then": {
                "required": [
                  "url",
                  "extensions"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "file-list"
                  }
                }
              },
              "then": {
                "required": [
                  "url"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "files"
                  }
                }
              },
              "then": {
                "required": [
                  "files"
                ]
              }
            }
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^/\\]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2000
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "md5": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        }
      }
    }
  }
}
